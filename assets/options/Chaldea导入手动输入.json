{
    "option": {
        "原生自动战斗使用Chaldea队伍": {
            "type": "select",
            "label": "是否使用 Chaldea 队伍",
            "description": "开启后，在选择助战并到达编队界面时自动应用 Chaldea 队伍，再进入战斗。关闭时保持原有进本流程。自动编队不会按等级或技能等级区分同名从者；请先将不希望选中的同名低等级从者移出从者列表（例如放入保管室），否则可能选中低等级从者并导致战斗方案无法正常执行。",
            "default": "否",
            "cases": [
                {
                    "name": "否",
                    "label": "否"
                },
                {
                    "name": "是",
                    "label": "是",
                    "option": [
                        "Chaldea导入手动输入",
                        "自动编队助战替代",
                        "自动编队礼装开关",
                        "自动编队礼装缺失处理",
                        "自动补齐从者和羁绊礼装"
                    ],
                    "pipeline_override": {
                        "进本-编队处理": {
                            "next": [
                                "执行自动编队"
                            ]
                        },
                        "自动编队完成": {
                            "next": [
                                "进本-点击队伍确认"
                            ]
                        }
                    }
                }
            ]
        },
        "Chaldea导入手动输入": {
            "type": "input",
            "label": "Chaldea 队伍导入",
            "description": "填写 Chaldea 的分享链接、队伍ID、关卡ID，或点击浏览按钮从本地选择队伍 JSON 文件。下载过的队伍缓存文件名（config/Battle 下，如\"诺100奥_77210_94149047\"）也可以直接填。开启“是否使用 Chaldea 队伍”或运行独立自动编队任务时必须填写。注意：自动编队不会按等级或技能等级区分同名从者，请先将不希望选中的同名低等级从者移出从者列表（例如放入保管室）。",
            "inputs": [
                {
                    "name": "chaldea_import_source",
                    "label": "分享链接 / 队伍ID / 关卡ID / 本地文件",
                    "default": "",
                    "verify": ".*",
                    "input_type": "file"
                }
            ],
            "pipeline_override": {
                "原生自动战斗入口": {
                    "action": {
                        "type": "Custom",
                        "param": {
                            "custom_action": "auto_battle",
                            "custom_action_param": {
                                "chaldea_import_source": "{chaldea_import_source}",
                                "max_turns": 20
                            }
                        }
                    }
                },
                "原生自动战斗_多次入口": {
                    "action": {
                        "type": "Custom",
                        "param": {
                            "custom_action": "auto_battle_repeat",
                            "custom_action_param": {
                                "chaldea_import_source": "{chaldea_import_source}",
                                "max_turns": 20
                            }
                        }
                    }
                },
                "执行自动编队": {
                    "attach": {
                        "chaldea_import_source": "{chaldea_import_source}"
                    }
                },
                "执行羁绊补齐自动编队": {
                    "attach": {
                        "chaldea_import_source": "{chaldea_import_source}"
                    }
                }
            }
        },
        "自动编队助战替代": {
            "type": "select",
            "label": "是否用助战代替编队数据",
            "description": "仅在 Chaldea 编队数据未标记助战时生效。选是后，当前助战必须与数据中的一个本地从者为同一从者，并代替该从者所在槽位；身份无法识别或不匹配时停止任务。数据已包含助战时始终按数据校验助战身份和位置。",
            "default": "否",
            "cases": [
                {
                    "name": "否",
                    "label": "否",
                    "pipeline_override": {
                        "执行自动编队": {"attach": {"use_support_substitution": false}},
                        "执行羁绊补齐自动编队": {"attach": {"use_support_substitution": false}}
                    }
                },
                {
                    "name": "是",
                    "label": "是",
                    "pipeline_override": {
                        "执行自动编队": {"attach": {"use_support_substitution": true}},
                        "执行羁绊补齐自动编队": {"attach": {"use_support_substitution": true}}
                    }
                }
            ]
        },
        "自动编队礼装开关": {
            "type": "select",
            "label": "自动编成礼装",
            "description": "关闭后仅调整从者和助战位置，完成从者复核后直接确认编队。",
            "default": "是",
            "cases": [
                {
                    "name": "是",
                    "label": "是",
                    "pipeline_override": {
                        "执行自动编队": {"attach": {"auto_equip": true}}
                    }
                },
                {
                    "name": "否",
                    "label": "否",
                    "pipeline_override": {
                        "执行自动编队": {"attach": {"auto_equip": false}}
                    }
                }
            ]
        },
        "自动编队礼装缺失处理": {
            "type": "select",
            "label": "满破礼装缺失时",
            "description": "仅当 Chaldea 要求满破、数据库和图片资源均存在但仓库未找到时生效。",
            "default": "跳过礼装",
            "cases": [
                {
                    "name": "跳过礼装",
                    "label": "跳过该礼装",
                    "pipeline_override": {
                        "执行自动编队": {"attach": {"equip_missing_policy": "skip"}}
                    }
                },
                {
                    "name": "查找非满破礼装",
                    "label": "改查非满破版本",
                    "pipeline_override": {
                        "执行自动编队": {"attach": {"equip_missing_policy": "allow_non_limit_break"}}
                    }
                }
            ]
        }
    }
}
