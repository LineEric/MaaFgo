{
    "option": {
        "自动编队Chaldea导入": {
            "type": "input",
            "label": "Chaldea 队伍导入",
            "description": "填写 Chaldea 分享链接、队伍 ID 或关卡 ID，或点击浏览按钮从本地选择队伍 JSON 文件。任务需从游戏的编队界面启动。",
            "inputs": [
                {
                    "name": "chaldea_import_source",
                    "label": "分享链接 / 队伍 ID / 关卡 ID / 本地文件",
                    "default": "",
                    "verify": ".*",
                    "input_type": "file"
                }
            ],
            "pipeline_override": {
                "执行自动编队": {
                    "attach": {
                        "chaldea_import_source": "{chaldea_import_source}"
                    }
                }
            }
        }
    }
}
