            "bbc弹窗信息输出"
        ],
        "attach": {
            "region": "{region}",
            "progress": "{progress}",
            "bbc_team_config": "{bbc_team_config}",
            "apple_type": "{apple_type}",
            "battle_type": "{battle_type}",
            "support_order_mismatch": "{support_order_mismatch}",
