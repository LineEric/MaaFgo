{
  "原生自动战斗入口": {
    "action": {
      "type": "Custom",
      "param": {
        "custom_action": "auto_battle"
      }
    },
    "on_error": [
      "原生自动战斗-队伍下载失败-提示"
    ]
  },
  "原生自动战斗-队伍下载失败-提示": {
    "doc": "保留既有错误出口名称。auto_battle 的队伍下载、初始编队会话或战斗执行失败时提示并终止整条任务链，具体原因由 Action 日志给出。",
    "focus": {
      "Node.Action.Starting": "<span style=\"color: #FF0000;\">原生自动战斗失败或已中断，任务终止。请查看上方具体错误：队伍下载、初始编队或战斗执行。</span>"
    },
    "action": {
      "type": "StopTask"
    }
  },
  "原生自动战斗_Chaldea入口": {
    "action": {
      "type": "Custom",
      "param": {
        "custom_action": "auto_battle",
        "custom_action_param": {
          "chaldea_import_source": "https://chaldea.center/team?id=17300",
          "max_turns": 20
        }
      }
    },
    "on_error": [
      "原生自动战斗-队伍下载失败-提示"
    ]
  },
  "原生自动战斗_多次入口": {
    "action": {
      "type": "Custom",
      "param": {
        "custom_action": "auto_battle_repeat",
        "custom_action_param": {
          "battle_count": 1
        }
      }
    }
  }
}
